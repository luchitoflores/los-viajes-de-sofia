  "dialogues": {
    "arrival": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "heidegger",
          "speaker": "Martin Heidegger",
          "text": "La existencia humana ya está implicada en un mundo de relaciones, tareas y posibilidades. Preguntemos cómo se nos abre ese mundo, antes de tratarlo como una colección de cosas aisladas.",
          "choices": [
            {
              "id": "continue",
              "text": "Continuar explorando"
            }
          ]
        }
      }
    },
    "everyday": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "clara",
          "speaker": "Clara",
          "text": "Arreglo esta cabaña, uso herramientas y organizo mis tareas. Las cosas aparecen ligadas a lo que estoy haciendo. ¿Soy primero una mente separada que después se conecta al mundo?",
          "choices": [
            {
              "id": "world",
              "text": "Ya estás implicada en un contexto de actividades y relaciones.",
              "feedback": "Ser-en-el-mundo nombra esa estructura. El cuidado no significa solo preocupación afectiva: reúne nuestra situación, nuestras posibilidades y nuestra ocupación cotidiana.",
              "reward": {
                "flags": [
                  "heidegger-care"
                ]
              }
            },
            {
              "id": "alone",
              "text": "Solo habría decisiones individuales sin situación previa.",
              "feedback": "Aquí no partimos de una elección que se inventa desde cero. Ya estamos situados en relaciones y significados."
            }
          ]
        }
      }
    },
    "temporality": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "clara",
          "speaker": "Clara",
          "text": "Mis proyectos se abren desde una situación que no elegí por completo y orientan lo que hago ahora. ¿El tiempo de la existencia es solamente una fila de instantes?",
          "choices": [
            {
              "id": "possibilities",
              "text": "Pasado, posibilidades y presente se articulan en esa existencia.",
              "feedback": "La temporalidad ayuda a comprender la unidad del cuidado. No es simplemente contar minutos ni trasladar sin más la libertad de Sartre a Heidegger.",
              "reward": {
                "flags": [
                  "heidegger-time"
                ]
              }
            }
          ]
        }
      }
    }
  },
