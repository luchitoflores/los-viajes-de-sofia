  "dialogues": {
    "arrival": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "hegel",
          "speaker": "Georg W. F. Hegel",
          "text": "Comprender una forma de vida requiere atender a su desarrollo y a las tensiones que la atraviesan. Una contradicción no es simplemente una pelea: puede mostrar límites internos de lo que tomábamos por estable.",
          "choices": [
            {
              "id": "continue",
              "text": "Continuar explorando"
            }
          ]
        }
      }
    },
    "conflict": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "marco",
          "speaker": "Marco",
          "text": "Nuestra comunidad proclama libertad para todos, pero sus reglas impiden a algunos participar. ¿Basta con repetir la declaración de libertad?",
          "choices": [
            {
              "id": "examine",
              "text": "Hay que examinar cómo las reglas contradicen esa pretensión.",
              "feedback": "La tensión obliga a revisar la forma concreta de realizar la libertad. No se resuelve siguiendo una receta de tres pasos.",
              "reward": {
                "flags": [
                  "hegel-conflict"
                ]
              }
            },
            {
              "id": "silence",
              "text": "Es mejor ocultar el conflicto para conservar el orden.",
              "feedback": "Ocultarlo no explica por qué la comunidad produce aquello que niega su propia pretensión."
            }
          ]
        }
      }
    },
    "development": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "ana",
          "speaker": "Ana",
          "text": "Subir no significa que toda historia mejore automáticamente. En una transformación se cuestionan formas anteriores y también se conservan determinaciones. ¿Qué tendría que cambiar para realizar mejor aquella libertad?",
          "choices": [
            {
              "id": "mediate",
              "text": "Revisar las instituciones y lo que permiten hacer a cada persona.",
              "feedback": "Pensar el desarrollo exige reconstruir sus mediaciones y sus límites; no basta sumar opiniones enfrentadas.",
              "reward": {
                "flags": [
                  "hegel-development"
                ]
              }
            }
          ]
        }
      }
    }
  },
