  "dialogues": {
    "arrival": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "kant",
          "speaker": "Immanuel Kant",
          "text": "Conocer requiere experiencia, pero también las formas y reglas con las que la organizamos. Y actuar moralmente exige examinar la máxima de nuestra acción, no solo calcular lo que nos conviene.",
          "choices": [
            {
              "id": "continue",
              "text": "Continuar explorando"
            }
          ]
        }
      }
    },
    "knowledge": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "elena",
          "speaker": "Elena",
          "text": "Observo una piedra y anoto sus cambios. ¿Conocer consiste únicamente en acumular sensaciones?",
          "choices": [
            {
              "id": "forms",
              "text": "También importa cómo ordenamos lo que recibimos.",
              "feedback": "La experiencia proporciona materia; nuestra sensibilidad y entendimiento hacen posible una experiencia organizada. Eso no equivale a inventar a voluntad lo real.",
              "reward": {
                "flags": [
                  "kant-knowledge"
                ]
              }
            },
            {
              "id": "copy",
              "text": "La mente sería una copia pasiva de todo lo que llega.",
              "feedback": "Prueba a distinguir la sensación de los marcos y conceptos con que reconocemos objetos."
            }
          ]
        }
      }
    },
    "morality": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "kant",
          "speaker": "Immanuel Kant",
          "text": "Alguien pide un préstamo prometiendo devolverlo, aunque sabe que no piensa cumplirlo. ¿Qué máxima guía esa acción?",
          "choices": [
            {
              "id": "universal",
              "text": "Prometer falsamente cuando me convenga: ¿podría quererlo como ley universal?",
              "feedback": "Si esa máxima se universalizara, socavaría la confianza que la propia promesa presupone. El examen moral considera la máxima y el deber, no el balance de beneficios.",
              "reward": {
                "flags": [
                  "kant-duty"
                ]
              }
            },
            {
              "id": "benefits",
              "text": "Sería correcta siempre que obtuviera más beneficios.",
              "feedback": "Para Kant, el resultado ventajoso no basta para justificar la máxima. Considera también a las personas como fines, y no meramente como instrumentos."
            }
          ]
        }
      }
    }
  },
