  "dialogues": {
    "arrival": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "camus",
          "speaker": "Albert Camus",
          "text": "Buscamos claridad y razones, pero el mundo no responde necesariamente a esa exigencia. El absurdo nace de esa confrontación. Visita a Sísifo: ¿cómo continuar sin ocultarnos lo que sabemos?",
          "choices": [
            {
              "id": "explore",
              "text": "Quiero escuchar a Sísifo.",
              "feedback": "Examina su esfuerzo y después vuelve a preguntar."
            }
          ]
        }
      }
    },
    "sisyphus-talk": {
      "start": "question",
      "nodes": {
        "question": {
          "characterId": "sisyphus",
          "speaker": "Sísifo",
          "text": "La roca vuelve a caer y tengo que empezar otra vez. Ser consciente de esa repetición cambia mi relación con ella. ¿La falta de un desenlace definitivo obliga a renunciar?",
          "choices": [
            {
              "id": "lucidity",
              "text": "Podrías continuar sin inventar una garantía final.",
              "feedback": "La lucidez no borra el esfuerzo. En la lectura de Camus, la rebelión sostiene la confrontación con el absurdo.",
              "reward": {
                "flags": [
                  "sisyphus-reflected"
                ]
              }
            },
            {
              "id": "reward",
              "text": "Solo tendría sentido si al final recibieras un premio.",
              "feedback": "Esa respuesta vuelve a exigir una justificación definitiva. ¿Podríamos examinar nuestra vida sin esa promesa?"
            }
          ]
        }
      }
    }
  },
