[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_room"]
script/source = "extends Control\n\n@export_multiline var bienvenida: String = \"Platón: Observa las sombras. ¿Son toda la realidad?\"\n@export_multiline var pregunta: String = \"¿Qué produce las sombras de la caverna?\"\n@export var paso: float = 48.0\nvar hablado := false\nvar comprendido := false\nfunc _ready() -> void:\n\t$Left.pressed.connect(func(): mover(-paso))\n\t$Right.pressed.connect(func(): mover(paso))\n\t$Talk.pressed.connect(hablar)\n\t$Correct.pressed.connect(func(): responder(true))\n\t$Wrong.pressed.connect(func(): responder(false))\n\t$Door.pressed.connect(salir)\n\t$Restart.pressed.connect(func(): get_tree().reload_current_scene())\nfunc mover(delta: float) -> void:\n\t$Sofia.position.x = clampf($Sofia.position.x + delta, 35.0, 800.0)\nfunc hablar() -> void:\n\thablado = true\n\t$Message.text = bienvenida + \"\\n\" + pregunta\nfunc responder(correcta: bool) -> void:\n\tif not hablado:\n\t\t$Message.text = \"Primero conversa con Platón.\"\n\t\treturn\n\tif correcta:\n\t\tcomprendido = true\n\t\t$Message.text = \"¡Correcto! La luz y los objetos producen las sombras. Salida desbloqueada.\"\n\t\t$Door.text = \"Salir (abierta)\"\n\telse:\n\t\t$Message.text = \"Piensa en lo que hay detrás de la pared. Inténtalo nuevamente.\"\nfunc salir() -> void:\n\t$Message.text = \"Capítulo de prueba completado.\" if comprendido else \"La salida está cerrada. Completa el desafío.\"\n"

[node name="Caverna" type="Control"]
